# ztOS's additions to the Lumia kernel's mmo_defconfig, merged by
# build-kernel.sh. Each line is a need of the GSI's kernel contract
# (design/ztOSIAL.md) or of this phone.

CONFIG_LOCALVERSION="-ztos-talkman"
# uname -r stays exactly the release and LOCALVERSION: modules go in one known place
# CONFIG_LOCALVERSION_AUTO is not set

# systemd, cgroups v2: the contract's hard requirement
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Waydroid: binderfs (the manifest's [android] binder = "binderfs")
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# The USB gadget (NCM network + ACM serial) in the boot stage's rescue shell,
# before any module can be loaded: the only way in while the port is brought up
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y

# The port's Type-C chip and battery gauge: the tree's last commits added these
# drivers, its defconfig does not enable them all
CONFIG_TYPEC=y
CONFIG_TYPEC_UC120=y
CONFIG_BATTERY_QCOM_PMI8994_FG=y

# Bluetooth audio and networking
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y

# A missing firmware file fails at once: the fallback waits a minute for
# a helper this system does not have, and the display's start waits with it
# CONFIG_FW_LOADER_USER_HELPER is not set

# pacman downloads in a Landlock sandbox: without it, it cannot fetch a package
CONFIG_SECURITY_LANDLOCK=y

# the cameras (SMIA++ / CCS sensors on CCI, camss)
CONFIG_I2C_QCOM_CCI=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_VIDEO_CCS=y

# motion sensors and the motor: small drivers in kernel/drivers
CONFIG_ICM20X48=y
CONFIG_INPUT_PMI8994_HAPTICS=y

# Wi-Fi: the QCA6174 on PCIe
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_QCOM=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y

# the modem
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_RMTFS_MEM=y

# pacman sandboxes its downloads with Landlock, which needs to be on the LSM list too
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
