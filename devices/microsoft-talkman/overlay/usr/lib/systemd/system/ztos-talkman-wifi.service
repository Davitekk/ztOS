[Unit]
Description=Start PCIe, and so Wi-Fi, once the firmware's file system is up
DefaultDependencies=no
After=local-fs.target
Before=NetworkManager.service network-pre.target
ConditionPathExists=/sys/module/pcie_qcom/parameters/start

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo 1 > /sys/module/pcie_qcom/parameters/start'

[Install]
WantedBy=multi-user.target
