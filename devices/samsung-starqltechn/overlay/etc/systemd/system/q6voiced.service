# q6voiced (postmarketOS): opens the DSP's voice path (VoiceMMode1) while
# ModemManager has a call up, so the call is heard.
[Unit]
Description=Call audio on the DSP's voice path
Requires=dbus.service
After=ModemManager.service

[Service]
Environment=HOME=/
EnvironmentFile=/usr/share/q6voiced/q6voiced.conf
ExecStart=/usr/bin/q6voiced hw:${q6voice_card},${q6voice_device}
KillMode=process
Restart=always
RestartSec=1
DynamicUser=yes
Group=audio

[Install]
WantedBy=multi-user.target
