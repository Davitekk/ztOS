#!/usr/bin/python3
"""ztOSCoreNetworking for the Galaxy S9 (Snapdragon): the Exynos S9's
ztoscorenetworkingd speaks AT commands to Samsung's modem; this phone's
Qualcomm modem is ModemManager's (QRTR). This daemon keeps
ztoscorenetworkingd's interface exactly, so the shell's status bar, Phone,
Messaging and Settings work unchanged, and does it all through ModemManager
(and NetworkManager for mobile data, callaudiod for where a call is heard):

  /run/ztoscorenetworking/status   key=value lines: sim, operator, bars (0-5),
                                   registered, tech, airplane, data, data_on,
                                   ip, wifi_bars, call, call_number, call_result;
                                   "modem" down the shell's pipe at each change
  /run/ztoscorenetworking.ctl      airplane on|off, data on|off, sms|smse
                                   NUMBER TEXT, call NUMBER, answer, hangup,
                                   speaker on|off, mute on|off, dtmf KEY, apn
  /var/lib/ztoscorenetworking/sms/log   in|out lines for Messaging
  /var/lib/ztoscorenetworking/calls     out|in|missed lines for Phone
  /etc/ztoscorenetworking/apn      the access point Settings writes (else the
                                   SIM's network's from .../apns)
"""
import os
import subprocess
import sys
import threading
import time

from gi.repository import Gio, GLib

MM = 'org.freedesktop.ModemManager1'
CTL = '/run/ztoscorenetworking.ctl'
STATUS_DIR = '/run/ztoscorenetworking'
STATUS = STATUS_DIR + '/status'
SMS_DIR = '/var/lib/ztoscorenetworking/sms'
SMS_LOG = SMS_DIR + '/log'
CALL_LOG = '/var/lib/ztoscorenetworking/calls'
APN_FILE = '/etc/ztoscorenetworking/apn'
APNS_FILE = '/usr/share/ztoscorenetworking/apns'
WANT_DATA = '/var/lib/ztoscorenetworking/data-on'
NM_CONNECTION = 'ztos-mobile'
PERIOD_S = 3

# MMModemState, MMCallState, MMSmsState
STATE_DISABLED, STATE_ENABLED, STATE_SEARCHING, STATE_REGISTERED, STATE_CONNECTED = 3, 6, 7, 8, 11
CALL_NAMES = {1: 'dialing', 2: 'ringing', 3: 'incoming', 4: 'active', 5: 'held', 6: 'incoming'}
SMS_RECEIVED = 3
# MMModemAccessTechnology bits, best first
TECH = ((0x8000, '5G'), (0x4000, '4G'), (0x200, 'H+'), (0x100, 'H'), (0x80, 'H'), (0x40, 'H'), (0x20, '3G'),
        (0x10, 'E'), (0x8, 'G'), (0x4, 'G'), (0x2, 'G'))
# MMModem3gppRegistrationState
REG = {1: 'home', 5: 'roaming', 2: 'searching', 3: 'denied', 6: 'home', 7: 'roaming', 9: 'home', 10: 'roaming'}

bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
status = {}
written = None
call = {'path': None, 'since': 0, 'answered': 0, 'incoming': False, 'number': ''}
dialing = {'number': '', 'until': 0}     # a call asked for, until ModemManager lists it
shell_after_publish = []                  # lines for the shell once the status is written
seen_sms = set()
user_runtime = None


def log(text):
    print('ztos-starq-mmbridge:', text, file=sys.stderr, flush=True)


def tell_shell(line):
    """The shell's control pipe, wherever its session is."""
    for uid in range(1000, 1010):
        path = f'/run/user/{uid}/ztmetro.ctl'
        try:
            fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)
        except OSError:
            continue
        try:
            os.write(fd, line.encode())
        except OSError:
            pass
        os.close(fd)


def append(path, line):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'a') as f:
        f.write(line)
    os.chmod(path, 0o644)


def call_dbus(path, interface, method, signature=None, args=None, timeout=30000):
    return bus.call_sync(MM, path, interface, method,
                         GLib.Variant(signature, args) if signature else None,
                         None, Gio.DBusCallFlags.NONE, timeout, None)


def prop(path, interface, name, default=None):
    try:
        value = bus.call_sync(MM, path, 'org.freedesktop.DBus.Properties', 'Get',
                              GLib.Variant('(ss)', (interface, name)), None, Gio.DBusCallFlags.NONE, 5000, None)
        return value.unpack()[0]
    except GLib.Error:
        return default


def modem_path():
    try:
        reply = bus.call_sync(MM, '/org/freedesktop/ModemManager1', 'org.freedesktop.DBus.ObjectManager',
                              'GetManagedObjects', None, None, Gio.DBusCallFlags.NONE, 5000, None)
    except GLib.Error:
        return None
    for path, interfaces in reply.unpack()[0].items():
        if MM + '.Modem' in interfaces:
            return path
    return None


# ---- what the status bar shows -------------------------------------------------

def nm_data():
    """(connected, ip) of our mobile connection in NetworkManager."""
    try:
        out = subprocess.run(['nmcli', '-t', '-g', 'GENERAL.STATE,IP4.ADDRESS', 'connection', 'show',
                              NM_CONNECTION], capture_output=True, text=True, timeout=10).stdout.split('\n')
    except (OSError, subprocess.TimeoutExpired):
        return False, ''
    connected = bool(out) and out[0].strip() == 'activated'
    ip = out[1].split('/')[0] if connected and len(out) > 1 else ''
    return connected, ip


def wifi_bars():
    """0-3 for the joined network's strength, -1 with none."""
    try:
        out = subprocess.run(['nmcli', '-t', '-f', 'ACTIVE,SIGNAL', 'device', 'wifi', 'list', '--rescan', 'no'],
                             capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return -1
    for line in out.splitlines():
        active, _, signal = line.partition(':')
        if active == 'yes' and signal.isdigit():
            s = int(signal)
            return 3 if s >= 70 else 2 if s >= 50 else 1 if s >= 30 else 0
    return -1


def refresh():
    m = modem_path()
    s = {'sim': 'absent', 'operator': '', 'bars': 0, 'registered': 'none', 'tech': '', 'airplane': 0,
         'data': 0, 'data_on': int(os.path.exists(WANT_DATA)), 'ip': '', 'wifi_bars': wifi_bars()}
    if m:
        state = prop(m, MM + '.Modem', 'State', 0)
        failed_reason = prop(m, MM + '.Modem', 'StateFailedReason', 0)
        sim = prop(m, MM + '.Modem', 'Sim', '/')
        lock = prop(m, MM + '.Modem', 'UnlockRequired', 0)
        # MMModemLock: 2 SIM PIN and 4 SIM PUK stop the SIM; PIN2 and PUK2 (3, 5)
        # only guard fixed dialling; 6 and up are the network's locks
        if failed_reason == 2 or sim in ('/', None):     # MM_MODEM_STATE_FAILED_REASON_SIM_MISSING
            s['sim'] = 'absent'
        elif lock == 2:
            s['sim'] = 'pin'
        elif lock == 4:
            s['sim'] = 'puk'
        elif lock in (0, 1, 3, 5) and failed_reason in (0, 1):
            s['sim'] = 'ready'
        else:
            s['sim'] = 'error'
        s['airplane'] = int(state == STATE_DISABLED or prop(m, MM + '.Modem', 'PowerState', 3) != 3)
        quality = prop(m, MM + '.Modem', 'SignalQuality', (0, False))[0]
        reg = prop(m, MM + '.Modem.Modem3gpp', 'RegistrationState', 0)
        s['registered'] = REG.get(reg, 'searching' if state == STATE_SEARCHING else 'none')
        registered = s['registered'] in ('home', 'roaming')
        s['bars'] = 0 if not registered else max(1, min(5, (int(quality) + 19) // 20))
        s['operator'] = prop(m, MM + '.Modem.Modem3gpp', 'OperatorName', '') if registered else ''
        techs = prop(m, MM + '.Modem', 'AccessTechnologies', 0)
        s['tech'] = next((name for bit, name in TECH if techs & bit), '') if registered else ''
    connected, ip = nm_data()
    s['data'], s['ip'] = int(connected), ip
    s.update(call_status())
    return s


def publish(s):
    global written
    if s == written:
        return
    os.makedirs(STATUS_DIR, exist_ok=True)
    with open(STATUS + '.new', 'w') as f:
        for key in ('call_result', 'call', 'call_number', 'sim', 'operator', 'bars', 'registered', 'tech',
                    'airplane', 'data', 'data_on', 'ip', 'wifi_bars'):
            f.write(f'{key}={s.get(key, "")}\n')
    os.chmod(STATUS + '.new', 0o644)
    os.replace(STATUS + '.new', STATUS)
    written = dict(s)
    tell_shell('modem\n')
    while shell_after_publish:
        tell_shell(shell_after_publish.pop(0))


# ---- calls --------------------------------------------------------------------

def amixer(name, value):
    subprocess.run(['amixer', '-q', '-c', '0', 'cset', f'name={name}', value], capture_output=True, timeout=5)


# The call's gains, as the profile (VoiceCall.conf) sets them: without
# stock's DSP calibration the call has none of its own. The mics' decimators
# at +26 dB (84 is 0 dB); the earpiece at -3 dB, stock's "handset-lf" (its
# "handset" -10 dB, 24, was hard to hear).
CALL_MIC_GAIN = '110'
CALL_EARPIECE_GAIN = '52'


def call_route(speaker):
    """The call on the earpiece or the bottom speaker, set on the MAX98512 pair
    itself, as Samsung's own call-handset and call-speaker paths do: the
    profile's Earpiece and Speaker are two PipeWire profiles, and callaudiod's
    switch found no Speaker in the one in use. The amp takes the mode at once
    (kernel/patch-max98512.py)."""
    if speaker:
        amixer('SPK Analog Left Gain', 'mute')
        amixer('One Stop Mode', 'Mono Right')
        amixer('SPK Analog Right Gain', '15dB')
    else:
        amixer('SPK Analog Right Gain', 'mute')
        amixer('Rcv Digital Gain', CALL_EARPIECE_GAIN)
        amixer('One Stop Mode', 'Receiver Left')
        amixer('SPK Analog Left Gain', '3dB')


def call_mute(on):
    """The call's microphones off or on (their decimators, at the call's gain)."""
    for dec in ('DEC7 Volume', 'DEC8 Volume'):
        amixer(dec, '0' if on else CALL_MIC_GAIN)


def callaudio(*args):
    """callaudiod (the user's session): the voice call's UCM verb and route."""
    for uid in range(1000, 1010):
        bus_path = f'/run/user/{uid}/bus'
        if os.path.exists(bus_path):
            name = subprocess.run(['id', '-nu', str(uid)], capture_output=True, text=True).stdout.strip()
            subprocess.run(['runuser', '-u', name, '--', 'env', f'DBUS_SESSION_BUS_ADDRESS=unix:path={bus_path}',
                            'callaudiocli', *args], capture_output=True, timeout=10)
            return


def call_status():
    m = modem_path()
    calls = prop(m, MM + '.Modem.Voice', 'Calls', []) if m else []
    live = None
    for path in calls:
        state = prop(path, MM + '.Call', 'State', 7)
        if state in CALL_NAMES:
            live = (path, state)
            break
    if not live and dialing['until'] > time.time():     # dialled, not listed yet
        return {'call': 'dialing', 'call_number': dialing['number'], 'call_result': ''}
    if live:
        dialing['until'] = 0
        path, state = live
        if call['path'] != path:          # a new call
            call.update(path=path, since=int(time.time()), answered=0,
                        incoming=prop(path, MM + '.Call', 'Direction', 2) == 1,
                        number=prop(path, MM + '.Call', 'Number', '') or '', result='')
            if call['incoming']:
                # once the status says "incoming" (publish): Phone, started
                # for it, quits at once when it reads no call
                shell_after_publish.extend(['screen on\n', 'call_screen\n'])
            callaudio('-m', '1')          # the voice call verb: earpiece and the mics
            call_route(speaker=False)
            call_mute(False)
        if state == 4 and not call['answered']:
            call['answered'] = int(time.time())
        return {'call': CALL_NAMES[state], 'call_number': call['number'], 'call_result': ''}
    if call['path']:                      # it ended
        lasted = int(time.time()) - call['answered'] if call['answered'] else 0
        kind = 'out' if not call['incoming'] else 'in' if call['answered'] else 'missed'
        append(CALL_LOG, f"{kind}\t{call['since']}\t{call['number'] or 'unknown'}\t{lasted}\n")
        if kind == 'missed':
            tell_shell(f"notify Phone|Missed call|{call['number'] or 'unknown'}\n")
        tell_shell('call_screen end\n')
        callaudio('-m', '0')
        call_mute(False)
        call['path'] = None
        call['result'] = 'ended'
    return {'call': 'idle', 'call_number': '', 'call_result': call.get('result', '')}


# ---- messages -----------------------------------------------------------------

def sms_in():
    m = modem_path()
    if not m:
        return
    try:
        paths = call_dbus(m, MM + '.Modem.Messaging', 'List').unpack()[0]
    except GLib.Error:
        return
    for path in paths:
        if path in seen_sms or prop(path, MM + '.Sms', 'State', 0) != SMS_RECEIVED:
            continue
        seen_sms.add(path)
        number = prop(path, MM + '.Sms', 'Number', '') or 'unknown'
        text = prop(path, MM + '.Sms', 'Text', '') or ''
        escaped = text.replace('\\', '\\\\').replace('\n', '\\n').replace('\t', ' ')
        append(SMS_LOG, f'in\t{int(time.time())}\t{number}\t{escaped}\n')
        tell_shell(f"notify Messaging|{number}|{escaped.replace('|', '/')[:240]}\n")
        try:
            call_dbus(m, MM + '.Modem.Messaging', 'Delete', '(o)', (path,))
        except GLib.Error as error:
            log(f'could not delete a message from the modem: {error.message}')
        log(f'a message came in ({len(text)} characters)')


def sms_out(number, text):
    m = modem_path()
    ok = False
    if m:
        try:
            path = call_dbus(m, MM + '.Modem.Messaging', 'Create', '(a{sv})',
                             ({'number': GLib.Variant('s', number), 'text': GLib.Variant('s', text)},)).unpack()[0]
            call_dbus(path, MM + '.Sms', 'Send', timeout=120000)
            ok = True
            call_dbus(m, MM + '.Modem.Messaging', 'Delete', '(o)', (path,))
        except GLib.Error as error:
            log(f'a message did not go: {error.message}')
    append(SMS_LOG, f"out\t{int(time.time())}\t{number}\t{'ok' if ok else 'failed'}\n")


# ---- mobile data --------------------------------------------------------------

def apn():
    """Settings' access point, else the SIM's network's (by the IMSI's MCC+MNC)."""
    cfg = {'apn': '', 'user': '', 'password': '', 'auth': ''}
    try:
        for line in open(APN_FILE):
            key, sep, value = line.partition('=')
            if sep and not line.startswith('#') and key.strip() in cfg:
                cfg[key.strip()] = value.strip()
    except OSError:
        pass
    if not cfg['apn']:
        m = modem_path()
        sim = prop(m, MM + '.Modem', 'Sim', '/') if m else '/'
        imsi = prop(sim, MM + '.Sim', 'Imsi', '') if sim not in ('/', None) else ''
        try:
            lines = open(APNS_FILE).read().splitlines()
        except OSError:
            lines = []
        for digits in (6, 5):
            code = imsi[:digits]
            for line in lines:
                if code and line.startswith(code + ' '):
                    cfg['apn'] = line[len(code) + 1:].strip()
                    break
            if cfg['apn']:
                break
    return cfg


# Mobile data is switched by a worker thread, one step at a time, and only to
# the latest wish. ModemManager 1.24 crashes (SIGSEGV, the SIM gone until it
# restarts) when connections come back to back: once the connection was
# deleted and added again with autoconnect on, so NetworkManager started one
# while `nmcli connection up` started another, and quick off/on taps made a
# third before the network had let the last one go ("OutOfCall").
DATA_SETTLE_S = 4                 # after a disconnect, before connecting again
data_wish = {'on': None, 'reapply': False}
data_lock = threading.Lock()
data_wake = threading.Event()


def nmcli(*args, timeout=30):
    return subprocess.run(['nmcli', *args], capture_output=True, text=True, timeout=timeout)


def data(on, reapply=False):
    """Mobile data on or off (reapply: the access point changed)."""
    if on:
        open(WANT_DATA, 'w').close()
    else:
        try:
            os.unlink(WANT_DATA)
        except FileNotFoundError:
            pass
    with data_lock:
        data_wish['on'] = on
        data_wish['reapply'] = data_wish['reapply'] or reapply
    data_wake.set()


def data_connection(reapply):
    """Our NetworkManager connection, made (autoconnect off) if it is missing or its access point changed."""
    cfg = apn()
    current = nmcli('-t', '-g', 'gsm.apn', 'connection', 'show', NM_CONNECTION)
    if current.returncode == 0 and current.stdout.strip() == cfg['apn'] and not reapply:
        return
    nmcli('connection', 'delete', NM_CONNECTION)
    args = ['connection', 'add', 'type', 'gsm', 'ifname', '*', 'con-name', NM_CONNECTION,
            'gsm.apn', cfg['apn'], 'connection.autoconnect', 'no']
    if cfg['user']:
        args += ['gsm.username', cfg['user'], 'gsm.password', cfg['password']]
    nmcli(*args)


def data_worker():
    applied, down_at = None, 0.0
    while True:
        data_wake.wait()
        data_wake.clear()
        with data_lock:
            on, reapply = data_wish['on'], data_wish['reapply']
            data_wish['reapply'] = False
        if on is None or (on == applied and not reapply):
            continue
        try:
            if on:
                time.sleep(max(0.0, down_at + DATA_SETTLE_S - time.monotonic()))
                if data_wake.is_set():          # changed its mind meanwhile
                    continue
                data_connection(reapply)
                nmcli('connection', 'up', NM_CONNECTION, timeout=90)
                # from now on NetworkManager brings it back by itself (after a
                # drop, at the next start)
                nmcli('connection', 'modify', NM_CONNECTION, 'connection.autoconnect', 'yes')
            else:
                nmcli('connection', 'modify', NM_CONNECTION, 'connection.autoconnect', 'no')
                nmcli('connection', 'down', NM_CONNECTION, timeout=60)
                down_at = time.monotonic()
            applied = on
        except (OSError, subprocess.TimeoutExpired) as error:
            log(f'data {"on" if on else "off"}: {error}')
        GLib.idle_add(lambda: tick() and False)     # once, on the main loop


# ---- the control pipe ---------------------------------------------------------

def unescape(text):
    out, i = [], 0
    while i < len(text):
        if text[i] == '\\' and i + 1 < len(text):
            out.append({'n': '\n', 't': '\t'}.get(text[i + 1], text[i + 1]))
            i += 2
        else:
            out.append(text[i])
            i += 1
    return ''.join(out)


def command(line):
    m = modem_path()
    if not line.startswith(('sms ', 'smse ')):
        log(f'asked: {line[:40]}')
    try:
        if line in ('screen on', 'screen off'):
            return
        if line in ('airplane on', 'airplane off') and m:
            call_dbus(m, MM + '.Modem', 'Enable', '(b)', (line == 'airplane off',))
        elif line in ('data on', 'data off'):
            data(line == 'data on')
        elif line.startswith(('sms ', 'smse ')):
            body = line[5:] if line.startswith('smse ') else line[4:]
            number, _, text = body.partition(' ')
            sms_out(number, unescape(text) if line.startswith('smse ') else text)
        elif line.startswith('call ') and m and not call['path']:
            number = ''.join(c for c in line[5:] if c in '0123456789+*#')
            # "dialing" at once: Phone reads "idle" before ModemManager lists
            # the call as a call that ended; and the call's sound route first,
            # so the voice path starts on the earpiece
            dialing.update(number=number, until=time.time() + 30)
            tick()
            callaudio('-m', '1')
            call_route(speaker=False)
            call_mute(False)
            try:
                path = call_dbus(m, MM + '.Modem.Voice', 'CreateCall', '(a{sv})',
                                 ({'number': GLib.Variant('s', number)},)).unpack()[0]
                call_dbus(path, MM + '.Call', 'Start')
            except GLib.Error:
                dialing['until'] = 0
                callaudio('-m', '0')
                raise
        elif line == 'answer' and call['path']:
            call_dbus(call['path'], MM + '.Call', 'Accept')
        elif line == 'hangup' and m:
            call_dbus(m, MM + '.Modem.Voice', 'HangupAll')
        elif line in ('speaker on', 'speaker off'):
            call_route(speaker=line == 'speaker on')
        elif line in ('mute on', 'mute off'):
            call_mute(line == 'mute on')
        elif line.startswith('dtmf ') and call['path']:
            key = line[5:6]
            if key and key in '0123456789*#ABCD':
                call_dbus(call['path'], MM + '.Call', 'SendDtmf', '(s)', (key,))
        elif line == 'apn' and os.path.exists(WANT_DATA):
            data(True, reapply=True)
    except (GLib.Error, OSError, subprocess.TimeoutExpired) as error:
        log(f'{line[:20]}: {getattr(error, "message", error)}')
    tick()


def on_ctl(channel, condition):
    try:
        lines = os.read(ctl_fd, 8192).decode(errors='replace')
    except BlockingIOError:
        return True
    for line in lines.splitlines():
        if line.strip():
            command(line.strip())
    return True


def tick():
    try:
        sms_in()
        publish(refresh())
    except Exception as error:      # never let one bad poll stop the daemon
        log(f'poll: {error}')
    return True


os.makedirs('/etc/ztoscorenetworking', exist_ok=True)
os.makedirs(SMS_DIR, exist_ok=True)
try:
    os.unlink(CTL)
except FileNotFoundError:
    pass
os.mkfifo(CTL, 0o666)
os.chmod(CTL, 0o666)
ctl_fd = os.open(CTL, os.O_RDWR | os.O_NONBLOCK)
# Settings writes the access point here as the user
if not os.path.exists(APN_FILE):
    open(APN_FILE, 'a').close()
os.chmod(APN_FILE, 0o666)
GLib.io_add_watch(GLib.IOChannel.unix_new(ctl_fd), GLib.PRIORITY_DEFAULT, GLib.IO_IN, on_ctl)
GLib.timeout_add_seconds(PERIOD_S, tick)
threading.Thread(target=data_worker, daemon=True).start()
tick()
log('up: ModemManager behind ztoscorenetworkingd\'s interface')
GLib.MainLoop().run()
