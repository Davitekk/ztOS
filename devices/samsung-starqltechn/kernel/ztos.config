# ztOS's additions to postmarketOS's sdm845 kernel config (config-sdm845.aarch64),
# merged by build-kernel.sh. Each line is a need of the GSI's kernel contract
# (design/ztOSIAL.md) or of this phone.

CONFIG_LOCALVERSION="-ztos-sdm845"
# uname -r stays exactly the release and LOCALVERSION: modules go in one known place
# CONFIG_LOCALVERSION_AUTO is not set

# Waydroid: binderfs (the manifest's [android] binder = "binderfs")
CONFIG_ANDROID_BINDERFS=y

# Wi-Fi: the BCM4361 on PCIe0, through brcmfmac with patch-brcmfmac-4361.py
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PROTO_MSGBUF=y
CONFIG_BRCMFMAC_PCIE=y
# CONFIG_BRCMFMAC_SDIO is not set
# CONFIG_BRCMFMAC_USB is not set
# CONFIG_BRCMSMAC is not set
# CONFIG_BRCM_TRACING is not set
# CONFIG_BRCMDBG is not set

# Bluetooth: the same chip's BT half on a QUP UART (hci_uart's bcm serdev)
CONFIG_BT_HCIUART_BCM=y

# Built in rather than modules: what the screen, the touchscreen and the
# battery need before the root is mounted (postmarketOS loads these from its
# initramfs: modules-initfs). The panel's supplies come from the S2DOS05 PMIC
# behind an i2c-gpio bus; none of these load firmware.
CONFIG_I2C_ALGOBIT=y
CONFIG_I2C_GPIO=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_MFD_SEC_CORE=y
CONFIG_REGULATOR_S2DOS05=y
CONFIG_MFD_MAX77705=y
CONFIG_CHARGER_MAX77705=y
CONFIG_BATTERY_MAX17042=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_MAX77693_HAPTIC=y
CONFIG_PWM_CLK=y
CONFIG_TOUCHSCREEN_S6SY761=y
CONFIG_INPUT_UINPUT=y

# The USB gadget (NCM network + ACM serial) in the boot stage's rescue shell,
# before any module can be loaded
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y

# PSI memory pressure on by default (ztos-memory-policy, earlyoom)
# CONFIG_PSI_DEFAULT_DISABLED is not set
